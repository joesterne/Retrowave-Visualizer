rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isAuthenticated() {
      // In this setup, we verify they are logged in.
      // Google Auth generally sets email_verified to true.
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidFavorite(data) {
      return data.keys().hasAll(['uid', 'type', 'id', 'title', 'createdAt']) &&
             data.keys().size() <= 10 &&
             data.uid == request.auth.uid &&
             data.type is string && data.type.size() <= 20 &&
             (data.type == 'track' || data.type == 'visualizer') &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 255 &&
             (!('subtitle' in data) || (data.subtitle is string && data.subtitle.size() <= 255)) &&
             (!('thumbnail' in data) || (data.thumbnail is string && data.thumbnail.size() <= 1000)) &&
             (!('source' in data) || (data.source is string && data.source.size() <= 50)) &&
             (!('url' in data) || (data.url is string && data.url.size() <= 1000)) &&
             (!('order' in data) || (data.order is number)) &&
             data.createdAt is timestamp;
    }

    function isValidSetting(data) {
      return data.keys().hasAll(['uid']) &&
             data.keys().size() <= 7 &&
             data.uid == request.auth.uid &&
             (!('volume' in data) || (data.volume is number && data.volume >= 0 && data.volume <= 1)) &&
             (!('vizMode' in data) || (data.vizMode is string && data.vizMode.size() <= 50)) &&
             (!('vizColor' in data) || (data.vizColor is string && data.vizColor.size() <= 10)) &&
             (!('fftSize' in data) || (data.fftSize is number)) &&
             (!('vizDensity' in data) || (data.vizDensity is number)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp));
    }

    match /favorites/{favoriteId} {
      allow get: if isAuthenticated() && isValidId(favoriteId) && existing().uid == request.auth.uid;
      allow list: if isAuthenticated() && existing().uid == request.auth.uid;
      allow create: if isAuthenticated() && isValidId(favoriteId) && isValidFavorite(incoming()) && incoming().createdAt == request.time;
      allow update: if isAuthenticated() && isValidId(favoriteId) && existing().uid == request.auth.uid && isValidFavorite(incoming()) &&
                    incoming().uid == existing().uid && incoming().createdAt == existing().createdAt &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['order']);
      allow delete: if isAuthenticated() && isValidId(favoriteId) && existing().uid == request.auth.uid;
    }

    match /settings/{userId} {
      allow get: if isAuthenticated() && isValidId(userId) && existing().uid == request.auth.uid;
      allow list: if isAuthenticated() && existing().uid == request.auth.uid;
      allow create: if isAuthenticated() && isValidId(userId) && userId == request.auth.uid && isValidSetting(incoming());
      allow update: if isAuthenticated() && isValidId(userId) && existing().uid == request.auth.uid && isValidSetting(incoming()) &&
                    incoming().uid == existing().uid && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['volume', 'vizMode', 'vizColor', 'fftSize', 'vizDensity', 'updatedAt']);
      allow delete: if isAuthenticated() && isValidId(userId) && existing().uid == request.auth.uid;
    }

    match /tokens/{userId}/providers/{provider} {
      allow read, write: if false; // Only server-side access
    }
  }
}
